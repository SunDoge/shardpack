<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(UsePackagedSdk)' != 'true'">
    <ProjectReference Include="../../src/SunDoge.ShardPack/SunDoge.ShardPack.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePackagedSdk)' == 'true'">
    <PackageReference Include="SunDoge.ShardPack" Version="$(Version)" />
  </ItemGroup>
</Project>
