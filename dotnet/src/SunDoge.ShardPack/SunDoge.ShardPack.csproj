<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>SunDoge.ShardPack</PackageId>
    <Description>Linux x64 (.NET 8+) ShardPack streams backed by Rust, with Zstd and AES-256-GCM.</Description>
    <Authors>SunDoge</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/SunDoge/shardpack</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NativeProfile Condition="'$(Configuration)' != 'Release'">debug</NativeProfile>
    <NativeProfile Condition="'$(Configuration)' == 'Release'">release</NativeProfile>
    <NativeBuildArgs Condition="'$(Configuration)' == 'Release'">--release</NativeBuildArgs>
    <NativeFileName Condition="$([MSBuild]::IsOSPlatform('Linux'))">libshardpack_ffi.so</NativeFileName>
    <NativeFileName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libshardpack_ffi.dylib</NativeFileName>
    <NativeFileName Condition="$([MSBuild]::IsOSPlatform('Windows'))">shardpack_ffi.dll</NativeFileName>
    <NativeLibraryPath>$(ShardPackRoot)/target/$(NativeProfile)/$(NativeFileName)</NativeLibraryPath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/README.md" />
    <None Include="$(NativeLibraryPath)" Link="$(NativeFileName)" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Pack="true" PackagePath="runtimes/$(NETCoreSdkRuntimeIdentifier)/native/" />
  </ItemGroup>
  <Target Name="BuildRustBindings" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BindingsOutput>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)rust-bindings'))</BindingsOutput>
    </PropertyGroup>
    <Exec WorkingDirectory="$(ShardPackRoot)" Command="cargo build -p shardpack-ffi --locked $(NativeBuildArgs)"
          EnvironmentVariables="SHARDPACK_BINDINGS_OUT=$(BindingsOutput);CARGO_TARGET_DIR=$(ShardPackRoot)/target" />
    <ItemGroup>
      <Compile Include="$(BindingsOutput)/NativeMethods.g.cs" />
    </ItemGroup>
  </Target>
</Project>
